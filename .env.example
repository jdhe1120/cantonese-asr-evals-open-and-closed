# Copy to .env and fill in only the models you run. .env is gitignored; never commit real keys.

# gemini: a billing-enabled key, or a free-tier key (25 requests/day). If both are set, the paid one is used.
GEMINI_API=
GEMINI_API_FREE_KEY=

# azure-standard and mai: an Azure Speech resource. MAI-Transcribe file transcription is only offered in some regions
# (centralindia, eastus, northeurope, southeastasia, westus, westus2).
MAI_ENDPOINT=https://<resource>.cognitiveservices.azure.com
MAI_API_KEY=

# cantonese-ai: key from https://cantonese.ai/api-keys (free tier: 10 requests per UTC day).
CANTONESE_AI_API_KEY=
# On a paid plan, its speech-to-text requests per minute (Lite 5, Pro 10, Ultra 20); empty = free tier, 1 call per 30 s.
CANTONESE_AI_RPM=

# Optional, read from the shell environment rather than this file:
#   GEMINI_USE=free         use the free Gemini key even when a paid one is set
#   GEMINI_DAILY_CAP=<n>    override the Gemini daily request cap (default 100 paid, 25 free)
